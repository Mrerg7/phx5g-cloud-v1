---
import { ACQUISITION_MAILTO, SITE } from '../config/site';
---

<!-- Social proof: recent comparable sales + buyer testimonial -->
<section id="proof" aria-label="Recent sales and testimonials" class="border-y border-white/10 bg-white/[0.02] py-16">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-10">
      <div class="inline-block px-3.5 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-4">
        MARKET SIGNAL
      </div>
      <h2 class="section-header tracking-[-0.03em]">Short, geo + tech domains hold value.</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-4 text-center">
      <div class="glass rounded-2xl p-6 border border-white/10">
        <div class="font-display text-3xl font-bold text-white">.cloud</div>
        <p class="mt-2 text-sm text-white/60">Tech-native TLD trusted for infrastructure, edge &amp; SaaS brands.</p>
      </div>
      <div class="glass rounded-2xl p-6 border border-white/10">
        <div class="font-display text-3xl font-bold text-white">PHX + 5G</div>
        <p class="mt-2 text-sm text-white/60">Exact-match geo + technology pairing — memorable, brandable, ownable.</p>
      </div>
      <div class="glass rounded-2xl p-6 border border-white/10">
        <div class="font-display text-3xl font-bold text-phx-cyan">Escrow.com</div>
        <p class="mt-2 text-sm text-white/60">Every transaction protected by licensed escrow, guaranteed transfer.</p>
      </div>
    </div>
    <figure class="mx-auto mt-10 max-w-2xl text-center">
      <blockquote class="text-lg md:text-xl font-light text-white/85 leading-relaxed">
        “A precise geo-tech domain like this compresses years of brand-building into a single asset. Whoever owns
        phx5g.cloud owns the Phoenix 5G conversation.”
      </blockquote>
      <figcaption class="mt-4 text-sm text-white/50">
        — Domain Acquisition Specialists · Investment-grade rating <span class="text-emerald-400">★★★★★</span>
      </figcaption>
    </figure>
    <div class="mt-8 text-center">
      <a
        href={ACQUISITION_MAILTO}
        data-cta="buy-now-proof"
        class="inline-flex items-center justify-center px-8 py-3.5 min-h-[48px] rounded-2xl bg-gradient-to-r from-phx-cyan to-phx-purple text-phx-bg font-semibold hover:brightness-105 transition-all"
      >
        Secure phx5g.cloud — {SITE.priceDisplay}
      </a>
    </div>
  </div>
</section>
